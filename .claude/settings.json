{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "kaggle-onboard": "on",
    "kaggle-validation": "on",
    "kaggle-experiment": "on",
    "kaggle-submit": "on",
    "kaggle-journal": "on",
    "kaggle-research": "on",
    "kaggle-retro": "on"
  }
}
